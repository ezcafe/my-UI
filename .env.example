# Server configuration
PORT=3000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:3000

# Session encryption secret (min 32 bytes, recommended 64-char random string)
SESSION_SECRET=your-random-32-or-64-byte-base64-secret-key-goes-here

# Pocket-ID OIDC Configuration
AUTH_ENABLED=true
OIDC_ISSUER_URL=https://id.example.com
OIDC_CLIENT_ID=my-ui-client
OIDC_CLIENT_SECRET=my-ui-client-secret
OIDC_REDIRECT_URL=http://localhost:3000/auth/callback

# Upstream Miniflux Configuration
MINIFLUX_BASE_URL=https://miniflux.example.com
MINIFLUX_API_KEY=your-miniflux-api-key-here

# AI Digest Configuration
AI_ENABLED=true
LLM_CLI_CMD=llm
# Example for OpenAI: LLM_MODEL=gpt-4o-mini, LLM_EXTRA_ARGS=""
# Example for Gemini: LLM_MODEL=gemini-2.5-flash, LLM_EXTRA_ARGS="--thinking-budget 0"
LLM_MODEL=gpt-4o-mini
LLM_EXTRA_ARGS=""
# Database Configuration (PostgreSQL 19)
# Host port mapping for Docker Compose (default: 5433 to prevent collision with native PostgreSQL on 5432)
# POSTGRES_PORT=5433
DATABASE_URL=postgres://my_ui:my_ui_password@localhost:5432/my_ui

# Native HTTP REST LLM Backend (Optional - sub-second responses via keep-alive connection pool)
# LLM_PROVIDER can be "openai" (OpenAI-compatible) or "gemini" (Google Gemini REST API)
# LLM_PROVIDER=openai
# LLM_API_KEY=your-api-key-here
# LLM_API_BASE_URL=https://api.openai.com/v1
